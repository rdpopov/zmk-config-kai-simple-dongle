#include "kai_simple.dtsi"

&default_transform {
    col-offset = <5>;
};

&kscan0 {
    diode-direction = "col2row";
    col-gpios
        = <&pro_micro 5 (GPIO_ACTIVE_HIGH)> // COL0
        , <&pro_micro 6 (GPIO_ACTIVE_HIGH)> // COL1
        , <&pro_micro 7 (GPIO_ACTIVE_HIGH)> // COL2
        , <&pro_micro 8 (GPIO_ACTIVE_HIGH)> // COL3
        , <&pro_micro 9 (GPIO_ACTIVE_HIGH)> // COL4
    ;
    row-gpios
        = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW0
        , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW1
        , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW2
        , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW3
    ;
};

&i2c0 {
    status = "okay";
    
    glidepoint1: glidepoint1@2a {
        compatible = "cirque,pinnacle";
        reg = <0x2A>;
        status = "okay";
        /* dr-gpios = <&xiao_d 3 (GPIO_ACTIVE_HIGH)>; */
        
        //default driver options
        sensitivity = "2x"; //1x, 2x, 3x, 4x
        //rotate-90;
        //x-invert;
        //y-invert;
        sleep;
        //no-secondary-tap;
        //no-taps;
        //x-axis-z-min = 5; //default 5, malformed value error
        //y-axis-z-min = 4; // default 4, malformed value error
        absolute-mode;
    };
};

&glidepointtranslator_listener {
    status = "okay";
    device = <&glidepoint1>;
    input-processors = <
        /*&zip_gestures*/
        /* &zip_temp_layer 5 500 */
        /*&zip_absolute_to_relative*/
        /*&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)*/
        &pointer_accel
    >;
};

// Overrides for the input-split child node
&glidepoint_split {
    device = <&glidepointtranslator_listener>;
    // Optional
        /*input-processors = <
            &zip_xy_scaler 2 1> // multiplier / divisor scaling
	    	&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
	    >;*/
};
