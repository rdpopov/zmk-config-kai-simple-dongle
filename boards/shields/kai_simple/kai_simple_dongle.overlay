#include <dt-bindings/zmk/matrix_transform.h>

#include "kai_simple-layout.dtsi"
#include "kai_simple_pinctrl.dtsi"

&default_layout {
    transform = <&default_transform>;
};

&i2c0 {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        com-sequential;
        prechargep = <0x22>;
        inversion-on;
    };

    glidepoint1: glidepoint1@2a {
        compatible = "cirque,pinnacle";
        reg = <0x2A>;
        status = "okay";
        /* dr-gpios = <&xiao_d 3 (GPIO_ACTIVE_HIGH)>; */
        
        //default driver options
        sensitivity = "2x"; //1x, 2x, 3x, 4x
        //rotate-90;
        //x-invert;
        //y-invert;
        sleep;
        //no-secondary-tap;
        //no-taps;
        //x-axis-z-min = 5; //default 5, malformed value error
        //y-axis-z-min = 4; // default 4, malformed value error
        absolute-mode;
    };
};

&glidepointtranslator_listener {
    status = "okay";
    device = <&glidepoint1>;
    input-processors = <
        /*&zip_gestures*/
        /* &zip_temp_layer 5 500 */
        /*&zip_absolute_to_relative*/
        /*&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)*/
        &pointer_accel
    >;
};

// Overrides for the input-split child node
&glidepoint_split {
    device = <&glidepointtranslator_listener>;
    // Optional
        /*input-processors = <
            &zip_xy_scaler 2 1> // multiplier / divisor scaling
	    	&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
	    >;*/
};

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &default_layout;
        zephyr,display = &oled;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;

        map = <
            RC(0,0)     RC(0,1)     RC(0,2)     RC(0,3)     RC(0,4)         RC(0,5)     RC(0,6)     RC(0,7)     RC(0,8 )    RC(0,9)
            RC(1,0)     RC(1,1)     RC(1,2)     RC(1,3)     RC(1,4)         RC(1,5)     RC(1,6)     RC(1,7)     RC(1,8)     RC(1,9)
            RC(2,0)     RC(2,1)     RC(2,2)     RC(2,3)     RC(2,4)         RC(2,5)     RC(2,6)     RC(2,7)     RC(2,8)     RC(2,9)
                                                RC(3,3)     RC(3,4)         RC(3,5)     RC(3,6)
        >;
    };
    
};

