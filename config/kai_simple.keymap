#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SCROLL 1
#define MOUSE 2
#define ADJ 3

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
};

&sl {
    release-after-ms = <2000>;
};

&lt {
    tapping-term-ms = <200>;
};

/ {

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LGUI  &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RET
              &mo SCROLL  &kp LALT  &kp SPACE   &kp RET &kp LCTL &mo MOUSE
                        >;

                };
                lower_layer {
                        display-name = "SCROLL";
                        bindings = <
   &kp GRAVE  &kp N1 &kp N2 &kp N3       &kp N4       &kp N5        &kp N6    &kp N7   &kp N8   &kp N9    &kp N0 &kp BSPC
   &trans     &kp N4 &kp N5 &kp N6       &kp MINUS    &kp EQUAL     &kp MINUS &kp LBKT &kp RBKT &kp EQUAL &trans &kp BSLH
   &trans     &kp N7 &kp N8 &kp N9       &kp N0       &trans        &trans    &trans   &trans   &trans    &trans &kp TAB
                            &kp LGUI     &trans       &kp SPACE     &kp SPACE &trans   &mo ADJ
                        >;
                };

                raise_layer {
                        display-name = "MOUSE";
                        bindings = <
   &kp  ESC  &kp Q &kp W &kp E &kp R &kp T      &msc SCRL_UP   &mkp MB2  &kp UP      &kp DOT    &kp FSLH &kp BSPC
   &kp LGUI  &kp A &kp S &kp D &kp F &kp G      &msc SCRL_DOWN &kp LEFT  &kp DOWN    &kp RIGHT  &trans   &trans
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B      &kp  HOME      &kp PG_UP &kp PG_DN   &kp END    &trans   &kp TAB
             &kp CLCK &trans &mkp MB1           &mkp MB2  &trans &trans
                        >;
                };
        };
};
